# ===== CONFIGURACIÓN DE EJEMPLO =====
# Copia este archivo a .env y completa con tus valores

# Email
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion

# Puerto
PORT=3000

# ===== BASE DE DATOS =====
DB_HOST=tu_host
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=tu_base_datos
DB_PORT=3306

# ===== CLOUDINARY =====
CLOUD_NAME=tu_cloud_name
CLOUD_API_KEY=tu_api_key
CLOUD_API_SECRET=tu_api_secret

# ===== FIREBASE =====
FIREBASE_API_KEY=tu_api_key
FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu_proyecto
FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
FIREBASE_APP_ID=tu_app_id
FIREBASE_MEASUREMENT_ID=tu_measurement_id

# ===== MERCADOPAGO - MODO PRUEBA =====
# Obtén estas credenciales en: https://www.mercadopago.com.co/developers/panel
# Pestaña: "Credenciales de prueba"
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret
APP_URL=http://localhost:3000

# ===== MERCADOPAGO - MODO PRODUCCIÓN =====
# Descomenta estas líneas cuando estés listo para producción
# MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MP_WEBHOOK_SECRET=tu_webhook_secret_produccion
# APP_URL=https://tu-dominio.com
